PORT=5000
FRONTEND_URL=http://localhost:8443

# Shared PostgreSQL connection. Do not commit real credentials.
DATABASE_URL=postgresql://username:password@localhost:5432/digital_logbook

# Gemini AI Project Progress integration.
# Each developer should provide their own API key in server/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TIMEOUT_MS=10000

# YouTube Learning Search integration.
# Each developer should provide their own API key in server/.env.
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_MS=10000

# Shared-project change emails (Brevo transactional email API).
# Leave BREVO_API_KEY or EMAIL_FROM empty to disable. EMAIL_FROM must be a
# sender verified in Brevo. Emails are never sent while tests are running.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Digital Notebook
EMAIL_TIMEOUT_MS=10000
# Minimum gap between emails to the same member about the same project.
COLLABORATOR_EMAIL_THROTTLE_MS=600000

# Temporary local-only switches for testing Project Details / Entries.
USE_FAKE_DB=true
DEV_BYPASS_AUTH=true
DEV_USER_ID=dev-user-1
DEV_USER_EMAIL=bethuel.test@wits.ac.za
