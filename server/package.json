    "migrate:shared-projects": "node scripts/applySharedProjectsMigration.js",
    "benchmark:custom-statistics": "node scripts/benchmarkCustomStatistics.js",
    "migrate:custom-dashboard": "node scripts/applyCustomDashboardMigration.js",
    "benchmark:dashboard": "node scripts/benchmarkDashboard.js"
